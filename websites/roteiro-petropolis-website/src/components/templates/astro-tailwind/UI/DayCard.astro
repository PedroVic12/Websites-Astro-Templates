---
import ButtonTailwind from "./ButtonTailwind.astro";
import ModalConcluido from "./ModalAnimado.astro";

const { day } = Astro.props;
const dayId = `day-${day.day}`;
---

<div class="relative pl-8 md:pl-12 day-container" data-day-id={dayId}>
    <div
        class="absolute -left-[17px] top-0 w-8 h-8 bg-[#ff9800] rounded-full flex items-center justify-center font-bold text-black border-4 border-black shadow-md"
    >
        {day.day}
    </div>

    <header
        class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6"
    >
        <div>
            <h3 class="text-xl font-bold text-white uppercase tracking-wide group-hover:text-purple-400 transition-colors">
                DIA {day.day} — {day.title}
            </h3>
            <p class="text-cyan-400 text-xs font-medium mt-1 uppercase tracking-widest">
                🎯 Foco: {day.focus}
            </p>
        </div>

        <div class="flex flex-col items-end gap-1.5">
            <span class="text-[10px] text-purple-300 font-mono progress-text"
                >0%</span
            >
            <div
                class="w-32 bg-gray-900 h-1.5 rounded-full overflow-hidden border border-purple-900/30"
            >
                <div
                    class="progress-bar bg-gradient-to-r from-purple-500 to-cyan-500 h-full transition-all duration-700 w-0"
                >
                </div>
            </div>
        </div>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
            day.events.map((ev: any, index: number) => (
                <label class="cursor-pointer group block">
                    <div class="h-full bg-white/5 border border-white/10 p-4 rounded-2xl flex items-start gap-4 transition-all hover:border-purple-500/50 hover:bg-white/10 has-[:checked]:border-yellow-500/40 has-[:checked]:bg-yellow-500/5">
                        <input
                            type="checkbox"
                            class="event-checkbox peer appearance-none w-5 h-5 border-2 border-gray-700 rounded-lg checked:bg-yellow-500 checked:border-yellow-500 transition-all mt-1"
                            data-index={index}
                        />

                        <div class="flex-1 peer-checked:opacity-30 transition-opacity">
                            <h4 class="text-yellow-500 font-bold text-xs mb-1 group-has-[:checked]:line-through">
                                {ev.time}
                            </h4>
                            <p class="text-gray-300 text-sm leading-snug">
                                {ev.desc}
                            </p>
                        </div>
                    </div>
                </label>
            ))
        }
    </div>

    <ModalConcluido id={`modal-${dayId}`} />
</div>

{
    day.day === 1 && (
        <div class="mt-8 md:hidden px-4">
            <ButtonTailwind
                titulo="Ver mapa do Hotel"
                variant="primary"
                onClick="abrirNoMaps"
            />
        </div>
    )
}

<script>
    const ConfettiEngine = {
        particles: [] as any[],
        canvas: null as HTMLCanvasElement | null,
        ctx: null as CanvasRenderingContext2D | null,

        init() {
            this.canvas = document.getElementById("confetti-canvas") as HTMLCanvasElement;
            if (!this.canvas) return;
            this.ctx = this.canvas.getContext("2d");
            this.canvas.width = window.innerWidth;
            this.canvas.height = window.innerHeight;
        },

        create(x: number, y: number) {
            const colors = ["#ff9800", "#3b82f6", "#10b981"];
            for (let i = 0; i < 100; i++) {
                this.particles.push({
                    x, y,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    size: Math.random() * 7 + 3,
                    speedX: (Math.random() - 0.5) * 12,
                    speedY: (Math.random() - 0.5) * 12 - 5,
                    gravity: 0.2,
                    opacity: 1
                });
            }
            this.animate();
        },

        animate() {
            if (!this.ctx || !this.canvas) return;
            this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
            this.particles.forEach((p, i) => {
                p.speedY += p.gravity;
                p.x += p.speedX; p.y += p.speedY;
                p.opacity -= 0.01;
                this.ctx!.fillStyle = p.color;
                this.ctx!.globalAlpha = p.opacity;
                this.ctx!.fillRect(p.x, p.y, p.size, p.size);
                if (p.opacity <= 0) this.particles.splice(i, 1);
            });
            if (this.particles.length > 0) requestAnimationFrame(() => this.animate());
        }
    };

    function init() {
        ConfettiEngine.init();
        document.querySelectorAll(".day-container").forEach((container: any) => {
            const dayId = container.getAttribute("data-day-id");
            const checks = container.querySelectorAll(".event-checkbox") as NodeListOf<HTMLInputElement>;
            const modal = document.getElementById(`modal-${dayId}`) as HTMLDialogElement;
            const closeBtn = modal?.querySelector("[data-close-modal]");
            
            const saved = JSON.parse(localStorage.getItem(`progresso-${dayId}`) || "[]");

            const update = (shouldCelebrate = false) => {
                const state = Array.from(checks).map((c) => c.checked);
                const total = checks.length;
                const completed = state.filter(Boolean).length;
                const percent = total > 0 ? (completed / total) * 100 : 0;
                
                const bar = container.querySelector(".progress-bar") as HTMLElement;
                const text = container.querySelector(".progress-text") as HTMLElement;
                
                if (bar) bar.style.width = `${percent}%`;
                if (text) text.textContent = `${Math.round(percent)}%`;
                
                localStorage.setItem(`progresso-${dayId}`, JSON.stringify(state));

                // Só celebra se o usuário clicou (não no carregamento inicial)
                if (percent === 100 && shouldCelebrate && !container.dataset.celebrated) {
                    container.dataset.celebrated = "true";
                    modal?.showModal();
                    ConfettiEngine.create(window.innerWidth/2, window.innerHeight/2);
                }
            };

            // Carrega estado inicial
            checks.forEach((cb, idx) => {
                cb.checked = !!saved[idx];
                cb.addEventListener("change", () => update(true));
            });

            // Lógica para fechar o modal
            closeBtn?.addEventListener("click", () => {
                modal?.close();
            });

            // Atualiza a barra sem disparar o modal no load
            update(false);
        });
    }

    // Inicializa no load
    init();

    // Reinicializa em navegações do Astro (se usar View Transitions)
    document.addEventListener("astro:after-swap", init);
    window.addEventListener("resize", () => ConfettiEngine.init());
</script>
