---
import Hero from "./Hero.astro";
import InfoCards from "./InfoCards.astro";
import ItinerarySection from "./ItinerarySection.astro";
import InsightSection from "./InsightSection.astro";
import Navbar from "./Navbar.astro";
import Toast from "./Toast.astro";

interface Props {
	data: any;
	Content: any;
}

const { data, Content } = Astro.props;

// Links dinâmicos extraídos do frontmatter
const url_maps = data.links?.maps || "#";
const url_hotel = data.links?.hotel || "#";
---

<script is:inline define:vars={{ url_maps, url_hotel }}>
	window.abrirNoMaps = () => {
		if (url_maps !== "#") window.open(url_maps, "_blank");
		else alert("Link do Maps não disponível para esta viagem.");
	};

	window.abrirSiteHotel = () => {
		if (url_hotel !== "#") window.open(url_hotel, "_blank");
		else alert("Site do Hotel não disponível.");
	};
</script>

<Toast />
<Navbar />

<Hero images={data.images} />

<main class="max-w-6xl mx-auto pb-24 px-4">
	<InfoCards logistics={data.logistics} base={data.base} />

	<ItinerarySection days={data.days} />

	<InsightSection>
		<Content />
	</InsightSection>
</main>
