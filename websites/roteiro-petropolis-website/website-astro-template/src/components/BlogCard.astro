---
interface Props {
    post: any;
}

const { post } = Astro.props;
const { title, summary, date, author, image } = post.data;
---

<a href={`/blog/${post.id}`} class="group block bg-[#1e1e1e]/40 border border-gray-800 rounded-3xl overflow-hidden hover:border-[#ff9800]/50 transition-all duration-300">
    <div class="aspect-video bg-gray-800 overflow-hidden">
        {image ? (
            <img src={image} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        ) : (
            <div class="w-full h-full flex items-center justify-center text-gray-700">
                <span class="text-4xl">🖼️</span>
            </div>
        )}
    </div>
    <div class="p-6">
        <div class="flex items-center gap-2 mb-3">
            <span class="text-[10px] font-bold uppercase tracking-widest text-[#ff9800]">{author}</span>
            <span class="text-gray-600">•</span>
            <span class="text-[10px] font-mono text-gray-500">{new Date(date).toLocaleDateString('pt-BR')}</span>
        </div>
        <h3 class="text-xl font-bold text-white mb-2 group-hover:text-[#ff9800] transition-colors">{title}</h3>
        <p class="text-sm text-gray-400 line-clamp-2 leading-relaxed">{summary}</p>
    </div>
</a>
