---
import MUIButton from './UI/MUIButton.tsx';

interface Props {
    title: string;
    subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section class="relative py-20 px-4 overflow-hidden bg-gradient-to-b from-gray-900 to-black">
    <div class="max-w-4xl mx-auto text-center relative z-10">
        <span class="inline-block px-4 py-1.5 mb-6 text-xs font-bold tracking-widest text-[#ff9800] uppercase bg-[#ff9800]/10 border border-[#ff9800]/20 rounded-full">
            Seja bem-vindo ao ViajaTech
        </span>
        <h1 class="text-5xl md:text-7xl font-black mb-6 leading-tight">
            {title}
        </h1>
        <p class="text-xl text-gray-400 mb-10 max-w-2xl mx-auto leading-relaxed">
            {subtitle}
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
            <MUIButton label="Explorar Roteiros" client:load />
            <a href="/blog" class="px-8 py-3 rounded-xl border border-gray-700 font-bold hover:bg-gray-800 transition">
                Ver Blog
            </a>
        </div>
    </div>
</section>
